{
  "name": "crm-juancitoads",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "version:write": "node -e \"require('fs').writeFileSync('.bot-version', require('./package.json').version + '\\n')\"",
    "deploy-check": "tsx scripts/deploy-check.ts",
    "predeploy": "pnpm css:build && pnpm icons:build && pnpm deploy-check && pnpm version:write",
    "deploy": "wrangler deploy",
    "deploy:ci": "node scripts/ci-deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "node scripts/db-apply.mjs",
    "db:apply:remote": "node scripts/db-apply.mjs --remote",
    "auditar": "tsx scripts/auditar-verdad.ts",
    "kb:reindex": "tsx scripts/generate-fixtures.ts",
    "eval": "tsx scripts/eval-bot-live.ts",
    "snapshot": "tsx scripts/admin-snapshot.ts",
    "css:build": "node scripts/build-admin-css.mjs",
    "css:check": "node scripts/build-admin-css.mjs --check",
    "icons:build": "node scripts/build-icons.mjs",
    "icons:check": "node scripts/build-icons.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/xai": "^3.0.106",
    "@anthropic-ai/sdk": "^0.90.0",
    "@cloudflare/containers": "^0.3.7",
    "agents": "^0.1.0",
    "ai": "^6.0.0",
    "hono": "^4.10.0",
    "resend": "^6.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "htmx.org": "2.0.4",
    "lucide-static": "^1.35.0",
    "miniflare": "latest",
    "tailwindcss": "^3.4.19",
    "tsx": "latest",
    "typescript": "^5",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
